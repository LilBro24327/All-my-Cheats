    ui.stBar.style.color = '#facc15';
    ui.stBar.textContent = 'Click the main target on canvas (or press L)';
  };

  ui.lkUpg.onclick = () => {
    st.waitMode = 2;
    ui.lkUpg.style.background = '#eab308';
    ui.stBar.style.color = '#facc15';
    ui.stBar.textContent = 'Click an upgrade sprite (or hover & press U)';
  };

  ui.clrUpg.onclick = () => { st.upgList = []; st.upgIdx = 0; updUpgUI(); renderUI(); };
  ui.rst.onclick = () => { st.tot = 0; st.ms = 0; st.cpsN = 0; st.cpsT = 0; ui.ck.textContent = '00:00:00'; ui.cp.textContent = '0'; ui.tt.textContent = '0'; };
  ui.tg.onclick = () => { if (st.pos) setR(st.run ? 0 : 1); };
  ui.scanBtn.onclick = () => { scanVars(); ui.stBar.textContent = `Scanned ${varMap.size} variables`; };
  ui.amtBtn.onclick = setAmt;
  ui.amtIn.onkeydown = e => { if (e.key === 'Enter') setAmt(); };
  ui.frzBtn.onclick = toggleFreeze;
  ui.sl.oninput = () => setS(slToSpd(Number(ui.sl.value)));
  ui.sv.onclick = () => {
    const v = prompt('Enter custom burst speed (1 - 250000):', st.spd);
    if (v !== null) setS(parseNum(v));
  };

  ui.minBtn.onclick = () => {
    st.min = !st.min;
    ui.body.style.display = st.min ? 'none' : 'flex';
    ui.minBtn.textContent = st.min ? '+' : '—';
  };

  window._wbC = () => {
    cancelAnimationFrame(st.raf);
    document.removeEventListener('mousemove', onMove);
    document.removeEventListener('mousemove', onDragMove);
    document.removeEventListener('mouseup', onDragUp);
    document.removeEventListener('keydown', onKey);
    cv.removeEventListener('click', onCanvasClick, true);
    ui.m.remove();
    delete window._wbVM;
    delete window._wbCV;
    delete window._wbUtil;
    delete window._wbUI;
    delete window._wbClick;
    delete window._wbVars;
    delete window._wbC;
  };

  ui.closeBtn.onclick = window._wbC;

  document.addEventListener('mousemove', onMove);
  ui.hd.addEventListener('mousedown', onHdDown);
  document.addEventListener('mousemove', onDragMove);
  document.addEventListener('mouseup', onDragUp);
  document.addEventListener('keydown', onKey);
  cv.addEventListener('click', onCanvasClick, true);

  st.raf = requestAnimationFrame(loop);
})();

