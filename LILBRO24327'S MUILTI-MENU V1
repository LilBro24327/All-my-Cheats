        } else {
            secNative.style.display = "none";
        }

        const sysTitle = guiRoot.querySelector('title') || guiRoot.querySelector('h1');
        if(sysTitle) sysTitle.innerText = "LilBro24327's Muilti-Cheat menu";
    }, 300);
})();
