                        if (ans.includes(b.innerText)) b.click();
                    });
                }
            }, 500);
            alert("Auto-Answer Engaged!");
        });
        buildDashboardItem(secBlooket, "1M Gold", () => {
            const s = getReactState(); if (s) { s.setState({ gold: 1000000 }); alert("Gold adjusted."); }
