  const colors = [['#2ecc71','#1e8449'],['#9b59b6','#6c3483'],['#f1c40f','#b7950b'],['#3498db','#21618c'],['#e67e22','#a04000']];
  Object.keys(localApps).forEach((name, i) => {
    window._trollUI.addBtn(name, colors[i][0], colors[i][1], () => openLocalFrame(name, localApps[name]));
  });

  // Pop-Out Web Apps (Bypasses CSP blocks)
  [
    { name: '🐱 Scratch (Popout)', url: 'https://mit.edu', c: '#f39c12', s: '#b9770e' },
    { name: '▶️ YouTube (Popout)', url: 'https://youtube.com', c: '#e74c3c', s: '#962d22' },
    { name: '🎧 Spotify (Popout)', url: 'https://spotify.com', c: '#1db954', s: '#14833b' },
    { name: '📚 Lumos (Popout)', url: 'https://lumoslearning.com', c: '#2980b9', s: '#1a5276' }
  ].forEach(app => {
    window._trollUI.addBtn(app.name, app.c, app.s, () => window.open(app.url, app.name, 'width=900,height=600,menubar=no,toolbar=no'));
  });
})();
