(() => {
  const $ = id => document.getElementById(id);
  const M = window.FNAF_MODELS, SFX = window.FNAF_SFX, C = window.FNAF_CORE;
  const canvas = $('fnaf-static'), ctx = canvas.getContext('2d');
  let staticAnim, gTimer, aiTimer, gfTimer;

  const resize = () => { canvas.width = innerWidth / 4; canvas.height = innerHeight / 4; };
  resize(); addEventListener('resize', resize);
  const drawStatic = () => {
    const img = ctx.createImageData(canvas.width, canvas.height), buf = new Uint32Array(img.data.buffer);
    for (let i = 0; i < buf.length; i++) { const v = Math.random() * 255; buf[i] = (255<<24)|(v<<16)|(v<<8)|v; }
    ctx.putImageData(img, 0, 0); staticAnim = requestAnimationFrame(drawStatic);
  };
  drawStatic();
  C.buildMap(); C.refreshMenu();

  function endGame(win, msg, modelHtml, cn20 = false) {
    C.st.on = false; clearInterval(gTimer); clearInterval(aiTimer); clearTimeout(gfTimer);
    win ? SFX.win() : SFX.scream();
    if (win) {
      const sv = C.loadSave();
      if (C.st.night < 5) sv.night = Math.max(sv.night, C.st.night + 1);
      else if (C.st.night === 5) { sv.stars = Math.max(sv.stars, 1); sv.n6 = true; }
      else if (C.st.night === 6) { sv.stars = Math.max(sv.stars, 2); sv.cn = true; }
      else if (C.st.night === 7 && cn20) { sv.stars = 3; }
      C.writeSave(sv); C.refreshMenu();
    }
    $('fnaf-office').style.display = 'none'; $('fnaf-end').style.display = 'flex';
    $('e-ico').className = win ? '' : 'jumpscare-anim';
    $('e-ico').innerHTML = modelHtml;
    $('e-ttl').textContent = win ? '6:00 AM' : 'GAME OVER';
    $('e-ttl').style.color = win ? '#6f6' : '#f33'; $('e-sub').textContent = msg;
  }

  function startNight(n, ai) {
    SFX.blip();
    C.st = { on:true, night:n, hr:0, pwr:100, ld:false, rd:false, ll:false, rl:false, cam:false, cur:'1A', gf:false, ai, pos:{f:'1A',b:'1A',c:'1A',x:0} };
    $('hud-night').textContent = n === 7 ? 'Custom Night' : `Night ${n}`;
    $('fnaf-menu').style.display = 'none'; $('fnaf-end').style.display = 'none'; $('fnaf-office').style.display = 'block';
    C.updateUI();

    const is420 = ai.f >= 20 && ai.b >= 20 && ai.c >= 20 && ai.x >= 20;
    let ticks = 0;
    gTimer = setInterval(() => {
      if (!C.st.on) return;
      if (++ticks % 15 === 0 && ++C.st.hr >= 6) return endGame(true, `You survived ${n === 7 ? 'Custom Night' : 'Night ' + n}!`, '<div style="font-size:80px">🎉</div>', is420);
      C.st.pwr -= (1 + C.st.ld + C.st.rd + C.st.ll + C.st.rl + C.st.cam) * 0.26;
      if (C.st.pwr <= 0) {
        C.st.pwr = 0; C.st.ld = C.st.rd = C.st.ll = C.st.rl = C.st.cam = C.st.gf = false;
        SFX.powerOut(); C.updateUI();
        setTimeout(() => C.st.on && endGame(false, 'Power ran out... Freddy got you.', M.freddy), 3000);
      }
      C.updateUI();
    }, 1000);

    aiTimer = setInterval(() => {
      const s = C.st; if (!s.on || s.pwr <= 0) return;
      let moved = false;
      if (Math.random() * 20 < s.ai.b) {
        const p = ['1A','1B','5','2A','3','2B','DOOR'];
        if (s.pos.b === 'DOOR') { if (!s.ld) return endGame(false, 'Bonnie got into the office!', M.bonnie); s.pos.b = '1B'; }
        else s.pos.b = p[p.indexOf(s.pos.b) + 1];
        moved = true;
      }
      if (Math.random() * 20 < s.ai.c) {
        const p = ['1A','1B','7','6','4A','4B','DOOR'];
        if (s.pos.c === 'DOOR') { if (!s.rd) return endGame(false, 'Chica got into the office!', M.chica); s.pos.c = '1B'; }
        else s.pos.c = p[p.indexOf(s.pos.c) + 1];
        moved = true;
      }
      if (!s.cam && Math.random() * 20 < s.ai.f) {
        const p = ['1A','1B','7','6','4A','4B','ATK'], nx = p[p.indexOf(s.pos.f) + 1];
        if (nx === 'ATK') { if (!s.rd) return endGame(false, 'Freddy snuck in!', M.freddy); s.pos.f = '4A'; }
        else { s.pos.f = nx; SFX.laugh(); }
        moved = true;
      }
      if (!s.cam && Math.random() * 20 < s.ai.x && ++s.pos.x >= 3) {
        if (!s.ld) return endGame(false, 'Foxy sprinted down the West Hall!', M.foxy);
        SFX.bang(); s.pwr = Math.max(0, s.pwr - 5); s.pos.x = 0;
      }
      if (moved) SFX.step();
      C.updateUI();
    }, 4200);
  }

  const tog = k => {
    const s = C.st; if (s.pwr <= 0) return;
    s[k] = !s[k];
    if (k === 'ld' || k === 'rd') SFX.door();
    if (k === 'll') { if (s.ll) s.rl = false; SFX.light(s.ll); }
    if (k === 'rl') { if (s.rl) s.ll = false; SFX.light(s.rl); }
    if (k === 'cam') {
      s.ll = s.rl = false; SFX.light(false); SFX.cam();
      clearTimeout(gfTimer);
      if (!s.cam && s.gf) gfTimer = setTimeout(() => s.on && s.gf && !s.cam && endGame(false, 'IT\'S ME', M.golden), 2800);
      if (s.cam && s.gf) s.gf = false;
    }
    C.updateUI();
  };

  $('b-ld').onclick = () => tog('ld'); $('b-rd').onclick = () => tog('rd');
  $('b-ll').onclick = () => tog('ll'); $('b-rl').onclick = () => tog('rl');
  $('cam-bar').onclick = () => tog('cam');

  const opts = Array.from(document.querySelectorAll('.fnaf-opt'));
  opts.forEach((o, i) => {
    o.onmouseenter = () => { if (!o.classList.contains('locked')) { SFX.blip(); opts.forEach((x, j) => x.classList.toggle('active', i === j)); } };
    o.onclick = () => {
      if (o.classList.contains('locked')) return;
      const act = o.dataset.act, sv = C.loadSave();
      if (act === 'new') { sv.night = 1; C.writeSave(sv); C.refreshMenu(); startNight(1, C.NIGHT_AI[1]); }
      if (act === 'cont') { const n = Math.min(sv.night, 5); startNight(n, C.NIGHT_AI[n]); }
      if (act === 'n6') startNight(6, C.NIGHT_AI[6]);
      if (act === 'cn') startNight(7, {
        f: +(prompt('Freddy (0-20):','20')||0), b: +(prompt('Bonnie (0-20):','20')||0),
        c: +(prompt('Chica (0-20):','20')||0), x: +(prompt('Foxy (0-20):','20')||0)
      });
    };
  });

  $('e-rst').onclick = () => { SFX.blip(); $('fnaf-end').style.display = 'none'; $('fnaf-menu').style.display = 'flex'; };

  const cleanup = () => {
    C.st.on = false; SFX.stopAll(); clearInterval(gTimer); clearInterval(aiTimer); clearTimeout(gfTimer); cancelAnimationFrame(staticAnim);
    removeEventListener('keydown', onKey); removeEventListener('resize', resize);
    $('fnaf-root')?.remove(); $('fnaf-style')?.remove();
  };
  const onKey = e => {
    if (e.key === 'Escape') return cleanup();
    if (!C.st.on) return;
    const k = e.key.toLowerCase();
    if (k === 'a') tog('ld'); if (k === 'd') tog('rd');
    if (k === 'q') tog('ll'); if (k === 'e') tog('rl');
    if (e.code === 'Space') { e.preventDefault(); tog('cam'); }
  };
  addEventListener('keydown', onKey);
  $('fnaf-close').onclick = cleanup;
  console.log('%c[Part 7/7 Loaded] Full 11-camera FNaF 1 edition ready!', 'color:#0f0;font-weight:bold;');
})();
