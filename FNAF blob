    step: () => tone(75, 'triangle', 0.14, 0.25, 30),
    bang: () => { tone(90, 'square', 0.35, 0.4, 25); noise(0.3, 0.4); },
    laugh: () => { tone(190, 'sawtooth', 0.18, 0.22, 130); setTimeout(() => tone(170, 'sawtooth', 0.22, 0.22, 110), 190); },
    light: (on) => {
      if (ctx.state === 'suspended') ctx.resume();
      if (buzzOsc) { buzzOsc.stop(); buzzOsc = null; }
      if (on) {
        buzzOsc = ctx.createOscillator(); buzzGain = ctx.createGain();
        buzzOsc.type = 'sawtooth'; buzzOsc.frequency.value = 60;
        buzzGain.gain.value = 0.05;
