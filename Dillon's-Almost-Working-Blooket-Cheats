        const f = Object.entries(n).find(([k]) => k.startsWith("__reactInternalInstance$") || k.startsWith("__reactFiber$"));
        if (!f) return null;
        return f[1]?.return?.memoizedProps || f[1]?.memoizedProps;
    };

    const l = (e, t = {}, ...a) => {
        const o = document.createElement(e);
        if (t.style) Object.assign(o.style, t.style), delete t.style;
        Object.assign(o, t);
        a.forEach(c => o.append(c));
        return o;
    };

    // --- 3. UI Creation ---
    const gui = l("div", {
        id: "DillonGUI",
