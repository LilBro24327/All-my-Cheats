    .dcmm-btn-nexus:hover { background: #4338ca; }
    .dcmm-btn-sec { background: #334155; }
    .dcmm-btn-sec:hover { background: #475569; }
    #dcmm-panel { display: none; background: #1e293b; border-bottom: 2px solid #3b82f6; padding: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; box-shadow: 0 12px 30px rgba(0,0,0,0.6); max-height: 80vh; overflow-y: auto; }
    #dcmm-panel.open { display: grid; }
    .dcmm-col h4 { margin: 0 0 10px 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: #38bdf8; border-bottom: 1px solid #334155; padding-bottom: 6px; }
    .dcmm-item { position: relative; display: block; padding: 8px 28px 8px 8px; border-radius: 6px; text-decoration: none; color: inherit; cursor: pointer; transition: background 0.15s; }
    .dcmm-item:hover { background: #334155; }
    .dcmm-item-title { font-weight: 600; font-size: 14px; color: #f1f5f9; }
    .dcmm-item-desc { font-size: 12px; color: #94a3b8; margin-top: 2px; }
    .dcmm-del { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #64748b; cursor: pointer; font-size: 12px; }
    .dcmm-del:hover { color: #ef4444; }
    #dcmm-modal { display: none; background: #0f172a; padding: 16px; border-bottom: 1px solid #334155; gap: 10px; flex-wrap: wrap; align-items: center; }
    #dcmm-modal.open { display: flex; }
    #dcmm-modal input, #dcmm-modal select { background: #1e293b; border: 1px solid #475569; color: white; padding: 6px 10px; border-radius: 4px; font-size: 13px; }
  `;

  const container = document.createElement('div');
  container.id = 'dev-console-mega-menu';
  container.appendChild(style);

  const bar = document.createElement('div');
  bar.id = 'dcmm-bar';
  bar.innerHTML = `
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <button id="dcmm-toggle" class="dcmm-btn">☰ Mega Menu</button>
      <button id="dcmm-quick-astro" class="dcmm-btn dcmm-btn-astro">🛰️ A.S.T.R.O.</button>
      <button id="dcmm-quick-nexus" class="dcmm-btn dcmm-btn-nexus">⚡ Nexus-Mega AI</button>
      <button id="dcmm-add-toggle" class="dcmm-btn dcmm-btn-sec">+ Add Stuff</button>
      <button id="dcmm-reset" class="dcmm-btn dcmm-btn-sec" title="Restore defaults">↺ Reset</button>
    </div>
    <button id="dcmm-close" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:16px;">✕</button>
  `;

  const modal = document.createElement('div');
  modal.id = 'dcmm-modal';
  modal.innerHTML = `
    <input id="dcmm-in-cat" placeholder="Category (e.g. My Links)" value="My Custom Tools" style="width:140px;" />
    <input id="dcmm-in-name" placeholder="Title (e.g. Jira Board)" style="width:150px;" />
    <input id="dcmm-in-desc" placeholder="Short description" style="width:160px;" />
    <select id="dcmm-in-type"><option value="url">URL Link</option><option value="code">JS Snippet</option></select>
    <input id="dcmm-in-val" placeholder="https://... or JS code" style="flex:1;min-width:200px;" />
    <button id="dcmm-save-btn" class="dcmm-btn">Save Item</button>
  `;

  const panel = document.createElement('div');
  panel.id = 'dcmm-panel';

  const renderPanel = () => {
    panel.innerHTML = '';
    window.DCMM.menuData.forEach((col, cIdx) => {
      const colDiv = document.createElement('div');
      colDiv.className = 'dcmm-col';
      colDiv.innerHTML = `<h4>${col.category}</h4>`;
      col.items.forEach((item, iIdx) => {
        const el = document.createElement(item.url ? 'a' : 'div');
        el.className = 'dcmm-item';
        if (item.url) { el.href = item.url; el.target = '_blank'; }
        else if (item.code) {
          el.onclick = (e) => {
            if (e.target.classList.contains('dcmm-del')) return;
            try { new Function(item.code)(); } catch (err) { console.error(err); }
            panel.classList.remove('open');
          };
        }
        el.innerHTML = `<div class="dcmm-item-title">${item.name}</div><div class="dcmm-item-desc">${item.desc || ''}</div><button class="dcmm-del" title="Delete">✕</button>`;
        el.querySelector('.dcmm-del').onclick = (e) => {
          e.preventDefault(); e.stopPropagation();
          window.DCMM.menuData[cIdx].items.splice(iIdx, 1);
          if (window.DCMM.menuData[cIdx].items.length === 0) window.DCMM.menuData.splice(cIdx, 1);
          window.DCMM.saveData(); renderPanel();
        };
        colDiv.appendChild(el);
      });
      panel.appendChild(colDiv);
    });
  };

  renderPanel();
  container.append(bar, modal, panel);
  document.body.appendChild(container);

  document.getElementById('dcmm-toggle').onclick = () => panel.classList.toggle('open');
  document.getElementById('dcmm-quick-astro').onclick = () => window.launchAstroConsole();
  document.getElementById('dcmm-quick-nexus').onclick = () => window.launchNexusAI();
  document.getElementById('dcmm-add-toggle').onclick = () => { modal.classList.toggle('open'); panel.classList.add('open'); };
  document.getElementById('dcmm-close').onclick = () => container.remove();
  document.getElementById('dcmm-reset').onclick = () => {
    if (confirm('Reset menu to default starter pack?')) {
      localStorage.removeItem(window.DCMM.STORAGE_KEY);
      window.DCMM.menuData = JSON.parse(JSON.stringify(window.DCMM.defaultData));
      renderPanel();
    }
  };
  document.getElementById('dcmm-save-btn').onclick = () => {
    const cat = document.getElementById('dcmm-in-cat').value.trim() || 'My Custom Tools';
    const name = document.getElementById('dcmm-in-name').value.trim();
    const desc = document.getElementById('dcmm-in-desc').value.trim();
    const type = document.getElementById('dcmm-in-type').value;
    const val = document.getElementById('dcmm-in-val').value.trim();
    if (!name || !val) return alert('Please enter a Title and a URL/Code.');
    const newItem = { name, desc }; newItem[type] = val;
    let targetCol = window.DCMM.menuData.find(c => c.category.toLowerCase() === cat.toLowerCase());
    if (!targetCol) { targetCol = { category: cat, items: [] }; window.DCMM.menuData.push(targetCol); }
    targetCol.items.push(newItem);
    window.DCMM.saveData(); renderPanel();
    document.getElementById('dcmm-in-name').value = '';
    document.getElementById('dcmm-in-desc').value = '';
    document.getElementById('dcmm-in-val').value = '';
  };
  console.log("🚀 Part 6/6 Loaded: Mega Menu Online with A.S.T.R.O. & Nexus-Mega AI!");
})();
